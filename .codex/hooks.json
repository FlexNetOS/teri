{
  "description": "Codex hooks for teri; keep simulation/prediction claims and operational docs grounded in current source truth.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && \"$root/.codex/hooks/teri-context-session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Checking teri simulation truth"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && \"$root/.codex/hooks/teri-context-session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Refreshing teri truth context"
          }
        ]
      }
    ]
  }
}
