{
  "description": "Codex hooks for teri; keep simulation/prediction claims and operational docs grounded in current source truth.",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "rtk bash -lc 'root=$(rtk git rev-parse --show-toplevel) && \"$root/.codex/hooks/teri-context-session-start.sh\"'",
            "statusMessage": "Refreshing teri truth context",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "rtk bash -lc 'root=$(rtk git rev-parse --show-toplevel) && \"$root/.codex/hooks/teri-context-session-start.sh\"'",
            "statusMessage": "Checking teri simulation truth",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "sh -lc 'root=\"$(git rev-parse --show-toplevel)\"; exec rusty-idd next --base \"$root\"'",
            "statusMessage": "Rusty IDD front door: computing the next step",
            "timeout": 180,
            "type": "command"
          }
        ]
      }
    ]
  }
}
